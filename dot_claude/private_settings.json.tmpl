{
  "permissions": {
    "allow": [
      "Bash(gh pr checks:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run view:*)",
      "Bash(git commit:*)",
      "Bash(git mv:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git rm:*)",
      "Bash(npx nx build:*)",
      "Skill(worktrunk:worktrunk)"
    ],
    "ask": [
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push *-f)"
    ],
    "deny": [
      "Bash(*--no-verify*)",
      "Bash(*--no-hooks*)",
      "Bash(*--no-pre-commit-hook*)"
    ],
    "defaultMode": "default"
  },
  "model": "opus[1m]",
  "hooks": {
{{- if .laptop }}
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/cnorman/Library/Application Support/Bartender/NotchBar/AgentStatus/hooks/claude-event-hook.sh' Waiting # notchbar-agents-claude-hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/cnorman/Library/Application Support/Bartender/NotchBar/AgentStatus/hooks/claude-event-hook.sh' Auto # notchbar-agents-claude-hook"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/cnorman/Library/Application Support/Bartender/NotchBar/AgentStatus/hooks/claude-event-hook.sh' ToolFail # notchbar-agents-claude-hook"
          }
        ]
      }
    ],
{{- end }}
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }{{ if .laptop }},
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/cnorman/Library/Application Support/Bartender/NotchBar/AgentStatus/hooks/claude-event-hook.sh' Working # notchbar-agents-claude-hook"
          }
        ]
      }{{ end }}
    ]{{ if .laptop }},
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/cnorman/Library/Application Support/Bartender/NotchBar/AgentStatus/hooks/claude-event-hook.sh' Ended # notchbar-agents-claude-hook"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/cnorman/Library/Application Support/Bartender/NotchBar/AgentStatus/hooks/claude-event-hook.sh' Idle # notchbar-agents-claude-hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/cnorman/Library/Application Support/Bartender/NotchBar/AgentStatus/hooks/claude-event-hook.sh' Idle # notchbar-agents-claude-hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/cnorman/Library/Application Support/Bartender/NotchBar/AgentStatus/hooks/claude-event-hook.sh' Working # notchbar-agents-claude-hook"
          }
        ]
      }
    ]{{ end }}
  },
  "statusLine": {
    "type": "command",
    "command": "{{ .chezmoi.homeDir }}/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "hookify@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "worktrunk@worktrunk": true,
    "n8n-mcp-skills@n8n-mcp-skills": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "n8n-mcp-skills": {
      "source": {
        "source": "github",
        "repo": "czlonkowski/n8n-skills"
      }
    }
  },
  "tui": "fullscreen",
  "agentPushNotifEnabled": true,
  "mcpServers": {}
}
