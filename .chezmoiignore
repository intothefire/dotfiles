# Repo meta-files — must NOT be deployed into $HOME.
#
# These were once written as `/README.md` etc. chezmoi 2.72.0 rejects a leading slash
# outright ("invalid path") and refuses to run at all, so the anchoring had to go.
# Verified against 2.72.0: a bare pattern still ignores only the root-level target —
# `CLAUDE.md` here does NOT swallow ~/.claude/CLAUDE.md, which continues to deploy.
# Re-check that if these files ever gain a nested namesake in the source tree.
README.md
CLAUDE.md
docs
.gitignore
.idea
{{ if eq .role "laptop" }}
# authorized_keys is for the headless boxes (mac-dev / server) only —
# don't manage the laptop's (it's the controller; leave its ~/.ssh/authorized_keys alone).
.ssh/authorized_keys
{{ end }}
{{ if eq .role "minimal" }}
# minimal (Raspberry Pi): no Homebrew and no mise on these boxes; Tailscale SSH
# means there's no ~/.ssh at all, so authorized_keys would be pointless noise.
.config/brew
.config/mise
.ssh/authorized_keys
{{ end }}
{{ if or (eq .role "server") (eq .role "minimal") }}
# Agent config (~/.claude) is for the macOS workstations (laptop / mac-dev) only.
# The Linux AI box (server) and the Pis (minimal) have no use for it — and benjy is a
# disk-constrained Pi 3 where extra files have already caused an outage.
.claude
# worktrunk is a workstation tool (parallel agent worktrees). These boxes don't get the
# `wt` binary from the Brewfile, so the config would be inert clutter.
.config/worktrunk
{{ end }}
