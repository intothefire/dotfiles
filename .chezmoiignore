# Repo meta-files — must NOT be deployed into $HOME.
# Anchored with a leading slash so these match ONLY ~/<name>, not any nested file of
# the same name — an unanchored `CLAUDE.md` would also swallow ~/.claude/CLAUDE.md.
/README.md
/CLAUDE.md
/docs
.gitignore
.idea
{{ if eq .role "laptop" }}
# authorized_keys is for the headless boxes (mac-dev / server) only —
# don't manage the laptop's (it's the controller; leave its ~/.ssh/authorized_keys alone).
.ssh/authorized_keys
{{ end }}
{{ if eq .role "minimal" }}
# minimal (Raspberry Pi): no Homebrew and no mise on these boxes; Tailscale SSH
# means there's no ~/.ssh at all, so authorized_keys would be pointless noise.
.config/brew
.config/mise
.ssh/authorized_keys
{{ end }}
{{ if or (eq .role "server") (eq .role "minimal") }}
# Agent config (~/.claude) is for the macOS workstations (laptop / mac-dev) only.
# The Linux AI box (server) and the Pis (minimal) have no use for it — and benjy is a
# disk-constrained Pi 3 where extra files have already caused an outage.
.claude
{{ end }}
