# Chris's global sous configuration: the allowlist.

# --- Wrappers ---------------------------------------------------------------

[wrappers.vault]
prefix    = ["agent-vault", "run", "--vault", "{vault}", "--"]
# Detects a broker outage: verified with the broker host down, 2026-11-07.
preflight = ["agent-vault", "account", "whoami"]

[wrappers.vault.vars]
vault = "claude"

[wrappers.none]
prefix = []

# --- Harnesses --------------------------------------------------------------

[harnesses.claude]
kind     = "claude"
command  = ["claude", "--agent", "{agent}", "-n", "{name}"]
wrappers = ["vault"]
# Headless read-only review. `{prompt}` stays right after `-p`: --tools,
# --allowedTools and --disallowedTools take lists, so a later positional would
# be read as a tool name.
# --setting-sources "" loads no user, project or local settings. Without it the
# user allow list (git rm/commit/push, gh pr merge) and the reviewed repo's own
# .claude/settings*.json are unioned in, and dontAsk runs them: verified live.
# It also drops the global rtk hook; the rtk forms stay allowed in case a hook
# that rewrites `git log` to `rtk git log` is ever loaded here.
# The deny list closes `--output=<file>`, which git diff/log/show accept and
# which writes to any path; deny beats allow.
review   = ["claude", "-p", "{prompt}", "--model", "sonnet",
            "--setting-sources", "",
            "--tools", "Read,Grep,Glob,Bash",
            "--permission-mode", "dontAsk",
            "--allowedTools", "Read,Grep,Glob,Bash(git diff:*),Bash(rtk git diff:*),Bash(git log:*),Bash(rtk git log:*),Bash(git show:*),Bash(rtk git show:*),Bash(git status:*),Bash(rtk git status:*),Bash(ls:*),Bash(rtk ls:*)",
            "--disallowedTools", "Bash(git diff*--output*),Bash(rtk git diff*--output*),Bash(git log*--output*),Bash(rtk git log*--output*),Bash(git show*--output*),Bash(rtk git show*--output*)"]

# No agent-definition or session-name flag; `-p <profile>` is the nearest.
[harnesses.codex]
kind     = "codex"
command  = ["codex"]
wrappers = ["vault"]
review   = ["codex", "exec", "--sandbox", "read-only", "{prompt}"]

# Has `--agent`, but no agents are defined yet.
[harnesses.agy]
kind     = "agy"
command  = ["agy"]
wrappers = ["vault"]
trust    = "agy"       # sous pre-trusts each new worktree for agy
review   = ["agy", "--mode", "plan",
            "--settings", '{"permissions":{"allow":["command(git diff)","command(git log)","command(git show)","command(git status)","command(ls)","command(cat)","command(head)","command(tail)","command(wc)","command(pwd)"]}}',
            "--print", "{prompt}"]

# --- Roles ------------------------------------------------------------------

# commis and sous are the sous repo's agents/, symlinked by `moon run agents:install`.
[roles.commis]
harness = "claude"
wrapper = "vault"
agent   = "commis"

[roles.sous]
harness = "claude"
wrapper = "vault"
agent   = "sous"

[roles.planner]
harness = "claude"
wrapper = "vault"
agent   = "planner"

[roles.reviewer]
harness = "codex"
wrapper = "vault"

# agy taster parked until #67 / quota reset.
[roles.taster]
harness = "claude"
wrapper = "vault"

# --- Review -----------------------------------------------------------------

[review]
reviewers = ["reviewer", "taster"]

# --- Worktrees --------------------------------------------------------------

[worktree]
provider = "worktrunk"

# --- Projects --------------------------------------------------------------
{{- /*
  Per-machine values: [projects.*] and [ide]. Everything above is shared.
  Shared projects go first, unconditionally. A machine's own projects go in an
  `if eq .chezmoi.hostname "<name>"` block (see `chezmoi data`). Template
  comments render nothing, so each block's output is exactly its TOML lines.
*/}}

[projects.sous]
path = "~/Projects/norman.me/sous"
{{- if eq .chezmoi.hostname "Arthur" }}
[projects.dotfiles]
path = "~/Projects/norman.me/dotfiles"
[projects.homelab]
path = "~/Projects/norman.me/homelab.norman.me"
{{- end }}
{{- $ide := joinPath .chezmoi.homeDir "Library/Application Support/JetBrains/Toolbox/scripts/webstorm" }}
{{- /*
  IDE: WebStorm via its Toolbox script by default (the line above). To override
  on a machine, add a line here, below the default:
    {{- if eq .chezmoi.hostname "<name>" }}{{ $ide = "/path/to/ide" }}{{ end }}
*/}}

[ide]
command = [{{ $ide | quote }}]
