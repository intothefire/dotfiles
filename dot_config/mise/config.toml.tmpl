# mise global tool versions (github.com/jdx/mise). Per-project overrides via
# .mise.toml / .tool-versions in a repo.
#
# Exact pins so every machine gets identical versions; bump by hand.
# The JS package managers live here, not corepack: Node 25+ no longer bundles
# corepack. pnpm still honours a project's `packageManager` field, and Yarn 4
# repos use their committed yarnPath.

# Idiomatic version files: let mise honour a repo's rust-toolchain.toml (rust) and
# .node-version / .nvmrc (node) instead of the global pins below. This is how moon
# workspaces get their own toolchain in the interactive shell: .moon/toolchains.yml is
# the source of truth, moon writes rust-toolchain.toml from it (rust.syncToolchainConfig),
# and mise reads that. moon's own tasks still run through proto. Node has no moon sync —
# a workspace that wants a node pin in the shell commits .node-version by hand. Off by
# default in mise; any other tool keeps ignoring its idiomatic file.
[settings]
idiomatic_version_file_enable_tools = ["node", "rust"]

[tools]
node = "24.22.1"
npm = "12.2.1"
pnpm = "12.16.1"
"aqua:yarnpkg/berry" = "4.18.1"
{{ if or (eq .role "laptop") (eq .role "mac-dev") -}}
ruby = "4.0.6"
# Rust via rustup (mise drives it; toolchains still live in ~/.rustup, binaries
# in ~/.cargo/bin). rust-analyzer backs the rust-analyzer-lsp Claude plugin.
rust = { version = "1.99.1", components = ["rust-src", "rust-analyzer"] }
# claude-sync (syncs ~/.claude session state) from its GitHub release binaries,
# not npm: the npm package is a wrapper whose postinstall fetches the binary,
# and npm 12 skips install scripts by default, leaving no binary behind.
"github:tawanorg/claude-sync" = "1.17.2"
{{ end -}}
