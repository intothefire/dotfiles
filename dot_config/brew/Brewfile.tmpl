{{- /* Homebrew formulae, templated by role. Applied by run_once_01 via brew bundle. */ -}}
{{- $laptop := eq .role "laptop" -}}
{{- $macdev := eq .role "mac-dev" -}}
{{- $mac := eq .chezmoi.os "darwin" -}}
{{- $mobile := or (eq .role "laptop") (eq .role "mac-dev") -}}
# ===================================================================
#  role = {{ .role }}   os = {{ .chezmoi.os }}
#  Regenerated by chezmoi from Brewfile.tmpl — edit that, not this.
# ===================================================================

# --- Taps ---
tap "anomalyco/tap"
tap "dopplerhq/doppler"
tap "max-sixty/worktrunk"
tap "openclaw/tap"
tap "steipete/tap"
{{ if $mac }}tap "scouzi1966/afm"
{{ end }}
# ===== Core — every machine =====

# shell / terminal
brew "starship"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "zsh-you-should-use"
brew "tmux"
brew "tmuxinator"
{{ if $mac }}brew "coreutils"        # GNU coreutils (Linux already ships them)
brew "terminal-notifier"
{{ end }}
# modern CLI
brew "fzf"
brew "fzf-tab"
brew "zoxide"
brew "eza"
brew "bat"
brew "git-delta"
brew "atuin"
brew "direnv"

# dev toolchain
brew "gh"
brew "git-absorb"
brew "go"
brew "mise"
brew "corepack"
brew "nx"
brew "jq"
brew "pandoc"
brew "gnupg"
brew "mkcert"
brew "max-sixty/worktrunk/wt"
{{ if $mac }}brew "automake"         # mac build deps (Linux uses build-essential)
brew "libtool"
brew "pkgconf"
brew "zlib"
brew "openssl@3"        # ruby-build (mise) needs these to compile Ruby
brew "readline"
brew "libyaml"
{{ end }}
# AI / agents
brew "anomalyco/tap/opencode"
brew "rtk"
brew "openclaw/tap/gogcli"
{{ if $mac }}brew "scouzi1966/afm/afm"   # Apple Foundation Models — macOS only
{{ end }}
# secrets
brew "doppler"
brew "infisical"

# network / transfer
brew "rclone"
brew "rsync"
brew "caddy"
brew "ansible"
brew "iperf3"
{{ if $mac }}
# ===== macOS =====
brew "pam-reattach"     # Touch ID for sudo in tmux (run_once_02)
{{ end -}}
{{ if $laptop }}brew "dockutil"        # builds the Dock (run_once_03)
{{ end }}
{{- if $mobile }}
# ===== Mobile / RN + media (laptop + mac-dev) =====
brew "watchman"         # React Native
brew "ffmpeg"
brew "yt-dlp"
brew "beets"
brew "gamdl"
{{ end -}}
