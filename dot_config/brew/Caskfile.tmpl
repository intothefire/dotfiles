# Homebrew casks.  Applied by run_once_01 via `brew bundle --file=~/.config/brew/Caskfile`.
# Formulae live in ./Brewfile.  This is a chezmoi template — the Antigravity IDE is
# gated on {{ "{{ .laptop }}" }}, so it only installs on laptops.

# --- Security ---
cask "1password"
cask "1password-cli"

# --- AI ---
cask "claude"
cask "chatgpt"
cask "codexbar"
cask "kiro-cli"

# --- Browsers ---
cask "google-chrome"
cask "chromium"
cask "firefox"

# --- Cloud / sync ---
cask "dropbox"
cask "google-drive"
cask "gcloud-cli"
cask "tailscale-app"

# --- Productivity / PKM ---
cask "obsidian"
cask "raycast"
cask "setapp"
cask "hazel"
cask "hyperkey"

# --- Comms ---
cask "slack"
cask "whatsapp"
cask "zoom"
cask "linear"

# --- Dev ---
cask "iterm2"
cask "tower"
cask "kaleidoscope"
cask "antigravity-cli"
{{ if .laptop -}}
cask "antigravity-ide"   # laptop only
{{ end -}}

# --- Media / design ---
cask "figma"
cask "vlc"
cask "handbrake-app"

# --- Hardware / desk ---
cask "elgato-camera-hub"
cask "elgato-control-center"
cask "elgato-stream-deck"
