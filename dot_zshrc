# ~/.zshrc — managed by chezmoi (github.com/intothefire/dotfiles)
# Prompt: starship.  Framework: none — oh-my-zsh removed, replaced by the lean
# fragments under ~/.zsh_rc_files/.

# --- Homebrew env (login shells get this from .zprofile; non-login/tmux need it) ---
if [[ -z "$HOMEBREW_PREFIX" ]]; then
  for _b in /opt/homebrew/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
    [[ -x "$_b" ]] && eval "$("$_b" shellenv)" && break
  done; unset _b
fi

# --- Plugin loader: source a zsh plugin from whichever share dir has it —
#     Homebrew's prefix first, then Debian/apt's /usr/share. Lets one config
#     serve both brew and apt machines. Missing plugin -> quiet no-op. ---
_source_plugin() {   # $1 = path under the share dir, e.g. foo/foo.zsh
  local d
  for d in "${HOMEBREW_PREFIX:-/opt/homebrew}/share" /usr/share; do
    [[ -r "$d/$1" ]] && { source "$d/$1"; return 0; }
  done
  return 1
}

# --- Completion fpath (must be set BEFORE compinit runs below) ---
# Homebrew periodically resets its share dir to group-writable, which trips zsh's
# compinit security audit (the "insecure directories" prompt). Re-secure it each start.
if [[ -n "$HOMEBREW_PREFIX" && -d "$HOMEBREW_PREFIX/share" ]]; then
  chmod g-w "$HOMEBREW_PREFIX/share" 2>/dev/null
  fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions" "$HOMEBREW_PREFIX/share/zsh-completions" $fpath)
fi

# --- Completion init (the single compinit; fragments below rely on it) ---
autoload -Uz compinit
compinit

# --- Machine-local secrets (gitignored; NOT in the dotfiles repo) ---
# See ~/.config/.secrets. Holds OP_SERVICE_ACCOUNT_TOKEN + API keys.
[[ -f "$HOME/.config/.secrets" ]] && source "$HOME/.config/.secrets"

# --- Kiro CLI (pre block — keep near the top) ---
[[ -f "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.pre.zsh" ]] && builtin source "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.pre.zsh"

# --- Shell config fragments (order matters) ---
# mise and moon are NOT in this loop: they are sourced further down, after the last
# static PATH edit (see "Toolchain managers" below).
ZSH_RC_FILES="$HOME/.zsh_rc_files"
for frag in core plugins aliases wt path agent-vault; do
  [[ -f "$ZSH_RC_FILES/$frag" ]] && source "$ZSH_RC_FILES/$frag"
done
for cmd in "$ZSH_RC_FILES"/commands/*(N.); do source "$cmd"; done

# --- Java ---
export JAVA_HOME=/Library/Java/JavaVirtualMachines/zulu-17.jdk/Contents/Home

# --- Prompt ---
eval "$(starship init zsh)"

# --- Kiro CLI (post block — keep near the bottom) ---
[[ -f "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.post.zsh" ]] && builtin source "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.post.zsh"

# (worktrunk lives in the fragment loop above — ~/.zsh_rc_files/wt. It was duplicated here
# for a while; the fragment won or lost purely on source order, which is not a thing to
# leave to chance when the failure mode is a silent no-op.)

# --- bun ---
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"

# --- Antigravity CLI (installed via Homebrew now; binary on /opt/homebrew/bin) ---
export PATH="$HOME/.local/bin:$PATH"

# --- Toolchain managers: MUST come after every static PATH edit above ---
# mise activation prepends its tool dirs once now and again on every prompt/cd. Shells
# that never draw a prompt (`zsh -i -c`, agent tool shells) only get the first pass, so
# anything prepended after it wins there: ~/.local/bin/node (Hermes's node 22) used to
# shadow mise's node that way. moon must follow mise so its hook runs after mise's and
# can put a moon workspace's pinned toolchain in front. Precedence, highest first:
#   in a moon workspace: rustup proxies + proto shims (versions from .moon/toolchains.yml)
#   everywhere:          mise tools > ~/.local/bin > bun > proto shims/bin > the rest
for frag in mise moon; do
  [[ -f "$ZSH_RC_FILES/$frag" ]] && source "$ZSH_RC_FILES/$frag"
done
unset ZSH_RC_FILES cmd frag

# --- claude-sync (syncs ~/.claude sessions + memory across machines) ---
# Installed by mise (github backend) on laptop/mac-dev only — so guard
# BOTH halves, or shells on machines without it error on every exit.
if command -v claude-sync >/dev/null 2>&1; then
  # Pull in a subshell so the job is detached from the parent shell's job
  # table — avoids interactive `[1] 12345` / `[1] + done` noise.
  (claude-sync pull -q &) >/dev/null 2>&1
  # Push on exit. Synchronous by design: a backgrounded push would race the
  # shell's death and lose the session.
  trap 'claude-sync push -q' EXIT
fi

# --- Syntax highlighting: MUST be sourced last ---
_source_plugin zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi