# Prompts on `chezmoi init`; result written to ~/.config/chezmoi/chezmoi.toml.
# https://www.chezmoi.io/docs/reference/#special-files-and-directories

{{- $email := promptString "Git email address" }}
{{- $computer := promptString "Computer Name" }}
{{- $role := promptString "Role (laptop | mac-dev | server | minimal)" "laptop" }}
{{- $name := "Chris Norman" }}

[data]
  email = {{ $email | quote }}
  name = {{ $name | quote }}
  computername = {{ $computer | quote }}
  # role drives what gets installed/configured (see Brewfile.tmpl, run_once_*):
  #   laptop  = this machine — full GUI + mobile + media + everything
  #   mac-dev = headless remote Mac — core + AI + Ruby + mobile/RN + media, no GUI
  #   server  = Linux AI box — core + AI CLIs + Python/uv, no GUI/mac/mobile
  #   minimal = Raspberry Pi / small box — shell + CLI from apt, no Homebrew, no runtimes
  role = {{ $role | quote }}
  # convenience flags derived from role/os (use these in templates):
  laptop = {{ eq $role "laptop" }}
  brewless = {{ eq $role "minimal" }}
