#!/usr/bin/env {{ if eq .chezmoi.os "darwin" }}zsh{{ else }}bash{{ end }}
#
# First-run bootstrap: Homebrew, packages, language runtimes, JS/Python toolchain.
# Templated by role/os (see .chezmoi.toml.tmpl).
#   role = {{ .role }}   os = {{ .chezmoi.os }}
#
# Failure policy: CRITICAL steps (Homebrew, brew bundle) call die() -> non-zero
# exit, so chezmoi does NOT record run_once as complete and WILL retry. Fragile
# but non-essential steps (Ruby build, corepack, eas) warn and continue. This
# script must never exit 0 on a broken foundation.

die()  { echo "FATAL: $*" >&2; exit 1; }
warn() { echo "WARN:  $*" >&2; }
{{ if .brewless -}}
# ===== minimal role (Raspberry Pi / small box): apt-only shell stack. =====
# Runs INSTEAD of the Homebrew path below — no brew, mise, node/ruby, uv, bun, AI CLIs.
# Idempotent: installs only what's missing, so it is safe to re-run.
export DEBIAN_FRONTEND=noninteractive
pkgs="zsh tmux zsh-autosuggestions zsh-syntax-highlighting fzf zoxide bat eza git-delta ripgrep direnv"
missing=""
for p in $pkgs; do
  dpkg -s "$p" >/dev/null 2>&1 || missing="$missing $p"
done
if [ -n "$missing" ]; then
  sudo apt-get update || die "apt-get update failed — not recording run_once so it retries."
  sudo apt-get install -y --no-install-recommends $missing || die "apt install failed:$missing"
else
  echo "minimal: all apt packages already present."
fi

# starship: NOT from apt. Debian trixie ships 1.22.1, which predates the [cpp]
# module our starship.toml declares (added post-1.22) — so every login warns
# "Unknown key 'cpp'" and drops the segment. Install upstream (latest) to
# /usr/local/bin, which shadows any apt copy; matches the hand-fix on
# magrathea/benjy. Guard on the upstream binary so re-runs no-op — the installer
# always fetches latest, so its presence means a cpp-capable starship is in place.
# Critical: the homelab verify.yml checks `starship --version`, so a failed
# install must die() and let chezmoi retry rather than leave a plain prompt.
if [ ! -x /usr/local/bin/starship ]; then
  curl -sS https://starship.rs/install.sh | sh -s -- --yes --bin-dir /usr/local/bin \
    || die "starship upstream install failed — not recording run_once so it retries."
fi
echo "Bootstrap (minimal) complete. Restart your shell."
{{ else -}}
{{ if eq .chezmoi.os "darwin" }}
# 1. Xcode Command Line Tools
xcode-select --install 2>/dev/null || true
{{ end }}
# 2. Homebrew — CRITICAL
if ! command -v brew >/dev/null 2>&1; then
{{- if eq .chezmoi.os "linux" }}
  command -v apt-get >/dev/null 2>&1 && sudo apt-get update && \
    sudo apt-get install -y build-essential procps curl file git
{{- end }}
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
{{ if eq .chezmoi.os "darwin" -}}
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
{{- else -}}
for b in /home/linuxbrew/.linuxbrew/bin/brew "$HOME/.linuxbrew/bin/brew"; do
  [ -x "$b" ] && eval "$("$b" shellenv)" && break
done
{{- end }}
command -v brew >/dev/null 2>&1 || die "Homebrew not on PATH after install — not recording run_once so it retries."

# Trust the third-party taps the Brewfile declares — newer Homebrew refuses to load
# formulae from an untrusted tap during `brew bundle` (a fresh-machine blocker).
grep -E '^tap ' "$HOME/.config/brew/Brewfile" 2>/dev/null | sed -E 's/^tap "([^"]+)".*/\1/' | while read -r t; do
  brew tap "$t" >/dev/null 2>&1 || true
  brew trust "$t" >/dev/null 2>&1 || true
done

# 3. Formulae{{ if eq .chezmoi.os "darwin" }} + casks{{ end }} — CRITICAL
brew bundle --file="$HOME/.config/brew/Brewfile" || die "brew bundle (Brewfile) failed."
{{- if eq .chezmoi.os "darwin" }}
brew bundle --file="$HOME/.config/brew/Caskfile" || die "brew bundle (Caskfile) failed."
{{- end }}
# From here: idempotent toolchain — warn but don't fail the box on benign errors.

# 4. Node + Ruby via mise (versions from ~/.config/mise/config.toml — ruby is
#    gated to mac dev machines there). No rvm, no GPG signature dance.
if command -v mise >/dev/null 2>&1; then
  mise install || warn "mise install (node/ruby) had errors"
  eval "$(mise activate bash)" 2>/dev/null || true
fi

# 6. JS package managers via corepack
corepack enable || true
corepack prepare yarn@stable --activate || true    # Yarn 4.x
corepack prepare pnpm@latest --activate || true

# 7. Python via uv
command -v uv >/dev/null 2>&1 || curl -fsSL https://astral.sh/uv/install.sh | sh || warn "uv install failed"

# 8. Bun — the upstream installer appends its own `# bun` block to ~/.zshrc,
# which dot_zshrc already provides. That drift lands on a file chezmoi just
# wrote, so the NEXT `chezmoi apply --no-tty` dies on an unanswerable overwrite
# prompt. Snapshot the managed shell files and restore them if the installer
# touched them — the source of truth for both lives in this repo, so discarding
# any change it makes is always correct.
if ! command -v bun >/dev/null 2>&1; then
  for f in "$HOME/.zshrc" "$HOME/.zprofile"; do
    [ -f "$f" ] && cp "$f" "$f.prebun"
  done
  curl -fsSL https://bun.sh/install | bash || warn "bun install failed"
  for f in "$HOME/.zshrc" "$HOME/.zprofile"; do
    if [ -f "$f.prebun" ]; then
      cmp -s "$f" "$f.prebun" || cp "$f.prebun" "$f"
      rm -f "$f.prebun"
    fi
  done
fi
export BUN_INSTALL="$HOME/.bun"; export PATH="$BUN_INSTALL/bin:$PATH"
{{ if or (eq .role "laptop") (eq .role "mac-dev") }}
# 9. Global CLIs (mobile/RN)
bun add --global eas-cli || warn "eas-cli install failed"
{{ end }}
#{{ if eq .role "laptop" }}
#curl -fsSL https://github.com/zachfleeman/tasuki/raw/main/install.sh | bash
#{{ end }}
echo "Bootstrap complete. Restart your shell....."
{{- end }}
