#!/usr/bin/env {{ if eq .chezmoi.os "darwin" }}zsh{{ else }}bash{{ end }}
#
# First-run bootstrap: Homebrew, packages, language runtimes, JS/Python toolchain.
# Templated by role/os (see .chezmoi.toml.tmpl). Ordering matters — brew before
# bundle; node (mise, via brew) before corepack/bun/eas.
#   role = {{ .role }}   os = {{ .chezmoi.os }}
{{ if eq .chezmoi.os "darwin" }}
# 1. Xcode Command Line Tools
xcode-select --install 2>/dev/null || true
{{ end }}
# 2. Homebrew
if ! command -v brew >/dev/null 2>&1; then
{{- if eq .chezmoi.os "linux" }}
  # Homebrew-on-Linux build prerequisites
  command -v apt-get >/dev/null 2>&1 && sudo apt-get update && \
    sudo apt-get install -y build-essential procps curl file git
{{- end }}
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
{{ if eq .chezmoi.os "darwin" -}}
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
{{- else -}}
for b in /home/linuxbrew/.linuxbrew/bin/brew "$HOME/.linuxbrew/bin/brew"; do
  [ -x "$b" ] && eval "$("$b" shellenv)" && break
done
{{- end }}

# 3. Formulae{{ if eq .chezmoi.os "darwin" }} + casks{{ end }}
brew bundle --file="$HOME/.config/brew/Brewfile"
{{- if eq .chezmoi.os "darwin" }}
brew bundle --file="$HOME/.config/brew/Caskfile"
{{- end }}
{{ if or (eq .role "laptop") (eq .role "mac-dev") }}
# 4. Ruby via RVM (mac dev machines only)
if [ ! -d "$HOME/.rvm" ]; then \curl -sSL https://get.rvm.io | bash -s stable; fi
source "$HOME/.rvm/scripts/rvm"
# Install only if that exact ruby is missing — never rebuild an existing one.
rvm list strings 2>/dev/null | grep -qx 'ruby-4.0.6' || rvm install 4.0.6
rvm --default use 4.0.6
{{ end }}
# From here steps are idempotent; tolerate benign non-zero exits.

# 5. Node via mise (installed by brew above)
if command -v mise >/dev/null 2>&1; then
  mise use -g node@latest
  eval "$(mise activate bash)"
fi

# 6. JS package managers via corepack
corepack enable || true
corepack prepare yarn@stable --activate || true    # Yarn 4.x
corepack prepare pnpm@latest --activate || true

# 7. Python via uv
if ! command -v uv >/dev/null 2>&1; then curl -fsSL https://astral.sh/uv/install.sh | sh; fi

# 8. Bun
if ! command -v bun >/dev/null 2>&1; then curl -fsSL https://bun.sh/install | bash; fi
export BUN_INSTALL="$HOME/.bun"; export PATH="$BUN_INSTALL/bin:$PATH"
{{ if or (eq .role "laptop") (eq .role "mac-dev") }}
# 9. Global CLIs (mobile/RN)
bun add --global eas-cli || true    # Expo Application Services
{{ end }}
echo "Bootstrap complete. Restart your shell."
exit 0
