# ~/.zshenv — sourced for EVERY zsh invocation (login, interactive, and scripts).
# Keep this minimal; it runs even for non-interactive `zsh -c`.

# Rust / cargo on PATH.
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# If in HERDR skip wrapping with kiro
[[ -n "$HERDR_ENV" ]] && export PROCESS_LAUNCHED_BY_Q=1