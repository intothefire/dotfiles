# tproj — open (or re-attach to) a project tmux session with a preset layout.
#
#   tproj                 # session named after the current dir
#   tproj api             # session "api" for the current dir
#   tproj api ~/code/api  # session "api" for a specific dir
#
# Layout it builds: 3 windows —
#   edit  (one full pane)
#   run   (two side-by-side panes)
#   git   (one pane)
# Already running? It just attaches. Customise the block below per your taste;
# `tmux send-keys '<cmd>' C-m` in any pane auto-runs a command on launch.
tproj() {
  local dir="${2:-$PWD}"
  local name="${1:-${dir:t}}"       # zsh :t = basename of $dir
  name="${name//[.:]/_}"            # tmux disallows . and : in session names

  # Re-attach if it already exists.
  if tmux has-session -t "$name" 2>/dev/null; then
    if [[ -n "$TMUX" ]]; then tmux switch-client -t "$name"; else tmux attach -t "$name"; fi
    return
  fi

  # --- build the layout (detached, then attach at the end) ---
  tmux new-session  -d -s "$name" -c "$dir" -n edit
  # tmux send-keys   -t "$name":edit 'nvim .' C-m        # ← e.g. auto-open your editor

  tmux new-window   -t "$name": -c "$dir" -n run
  tmux split-window -h -t "$name":run -c "$dir"          # two panes side by side
  # tmux send-keys  -t "$name":run.1 'npm run dev' C-m   # ← left pane: dev server
  # tmux send-keys  -t "$name":run.2 'npm test -- --watch' C-m

  tmux new-window   -t "$name": -c "$dir" -n git

  tmux select-window -t "$name":edit
  if [[ -n "$TMUX" ]]; then tmux switch-client -t "$name"; else tmux attach -t "$name"; fi
}
