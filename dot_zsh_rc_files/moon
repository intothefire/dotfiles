# moon workspaces — the toolchain pinned in .moon/toolchains.yml beats mise's global one.
#
# mise is the global toolchain manager. Inside a moon workspace the versions in
# .moon/toolchains.yml must win instead. proto does not read that file (only moon does,
# and only for the tasks it runs), so a bare `node` in a workspace would otherwise get
# mise's version, and proto's own shim fails with "failed to detect an applicable
# version". This hook does the translation for the interactive shell:
#
#   * each toolchain with a `version:` → PROTO_<ID>_VERSION, and $PROTO_HOME/shims goes
#     to the front of PATH, ahead of mise
#   * rust → also RUSTUP_TOOLCHAIN, and ~/.cargo/bin (the rustup proxies) to the front.
#     mise's rustc/cargo shims force mise's own toolchain whatever RUSTUP_TOOLCHAIN says,
#     so they must not win in a workspace.
#
# Leaving the workspace undoes all of it. Variables are restored only if still holding the
# value set here, so a change mise made meanwhile is kept.
#
# ORDER: source this AFTER mise. mise's precmd/chpwd hook re-prepends its own paths, and
# zsh runs hooks in registration order, so this one must be registered later to win.
#
# Parsing is deliberately minimal: a top-level `<id>:` key followed by a `version:` line at
# its first indent level. The file is re-read when the workspace root changes, not on
# every prompt — after editing toolchains.yml, `cd` out and back in.

typeset -g  _moon_root=""      # workspace root currently applied ("" = none)
typeset -gi _moon_cargo=0      # 1 = this hook prepended a ~/.cargo/bin copy
typeset -gA _moon_want=()      # var -> value this hook sets while in the workspace
typeset -gA _moon_prev=()      # var -> value before entering ("1:<val>" or "0" = unset)

# Nearest ancestor holding a moon toolchain config → REPLY. moon 2 is toolchains.yml;
# toolchain.yml is moon 1's name.
_moon_find_root() {
  local d=$PWD
  while true; do
    if [[ -f $d/.moon/toolchains.yml || -f $d/.moon/toolchain.yml ]]; then
      REPLY=$d; return 0
    fi
    [[ $d == / || -z $d ]] && return 1
    d=${d:h}
  done
}

# Read "<id> <version>" pairs from a workspace's toolchain config into _moon_want.
_moon_load() {
  local f=$1/.moon/toolchains.yml line id="" indent="" v var
  [[ -f $f ]] || f=$1/.moon/toolchain.yml
  _moon_want=()
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line =~ '^([A-Za-z0-9_-]+):' ]]; then
      id=$match[1]; indent=""
    elif [[ -n $id && $line =~ '^([[:space:]]+)[^[:space:]#]' ]]; then
      [[ -z $indent ]] && indent=$match[1]
      [[ $match[1] == $indent && $line =~ '^[[:space:]]+version:[[:space:]]*["'\'']?([^"'\''#[:space:]]+)' ]] || continue
      v=$match[1]
      var=${id#unstable_}; var="PROTO_${(U)var//-/_}_VERSION"
      _moon_want[$var]=$v
      [[ $id == rust ]] && _moon_want[RUSTUP_TOOLCHAIN]=$v
    fi
  done < $f
}

_moon_restore() {
  local var
  for var in ${(k)_moon_want}; do
    [[ ${(P)var-} == $_moon_want[$var] ]] || continue   # someone changed it since — keep theirs
    if [[ $_moon_prev[$var] == 1:* ]]; then
      export $var=${_moon_prev[$var]#1:}
    else
      unset $var
    fi
  done
  _moon_want=(); _moon_prev=()
}

_moon_hook() {
  local REPLY root="" i var
  local shims=${PROTO_HOME:-$HOME/.proto}/shims bin=${PROTO_HOME:-$HOME/.proto}/bin
  local cargo=$HOME/.cargo/bin
  _moon_find_root && root=$REPLY

  # PATH is rebuilt to the same result on every run, whatever happened in between:
  #   ~/.proto/shims is MOVED, never duplicated: every copy is dropped, then exactly one is
  #     put back — at the front in a workspace, else just before ~/.proto/bin (where
  #     ~/.zsh_rc_files/path puts it).
  #   ~/.cargo/bin is owned by mise (rust's bin dir): mise strips extra copies itself, so
  #     the copy added here is dropped only while another copy exists. Removing it blindly
  #     could delete the only one left.
  path=(${path:#$shims})
  if (( _moon_cargo )); then
    if (( ${#${(M)path:#$cargo}} > 1 )); then i=${path[(i)$cargo]}; path[i]=(); fi
    _moon_cargo=0
  fi

  if [[ $root != $_moon_root ]]; then
    _moon_restore
    _moon_root=$root
    if [[ -n $root ]]; then
      _moon_load $root
      for var in ${(k)_moon_want}; do
        if (( ${(P)+var} )); then _moon_prev[$var]="1:${(P)var}"; else _moon_prev[$var]=0; fi
      done
    fi
  fi

  if [[ -z $root ]] || (( ! ${#_moon_want} )); then
    i=${path[(i)$bin]}                       # $#path+1 when absent → appended
    path=($path[1,i-1] $shims $path[i,-1])
    return 0
  fi

  # Re-assert on every run: mise's hook may have reset RUSTUP_TOOLCHAIN or its PATH order.
  for var in ${(k)_moon_want}; do export $var=$_moon_want[$var]; done
  path=($shims $path)
  if (( ${+_moon_want[RUSTUP_TOOLCHAIN]} )); then
    path=($cargo $path); _moon_cargo=1
  fi
}

autoload -Uz add-zsh-hook
add-zsh-hook precmd _moon_hook
add-zsh-hook chpwd _moon_hook
_moon_hook
