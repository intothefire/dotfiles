# Standalone zsh plugins (Homebrew) — replaces oh-my-zsh's plugin list.
# zsh-syntax-highlighting is intentionally NOT here: it must be sourced last,
# so it lives at the very end of ~/.zshrc.

# Fish-style autosuggestions (accept with -> / End). From brew or apt share dir
# via the loader defined in ~/.zshrc.
_source_plugin zsh-autosuggestions/zsh-autosuggestions.zsh

# "you-should-use": nudges you toward an existing alias after you type the long
# form. Not in apt — cloned via .chezmoiexternal, so source from the clone path.
source "$HOME/.config/zsh/plugins/zsh-you-should-use/you-should-use.plugin.zsh" 2>/dev/null

# fzf: fuzzy history (Ctrl-R), file picker (Ctrl-T), dir jump (Alt-C)
command -v fzf >/dev/null 2>&1 && source <(fzf --zsh) 2>/dev/null

# zoxide: `z <dir>` frecency jumping, `zi` for interactive pick
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# atuin: better history search. Init AFTER fzf so atuin owns Ctrl-R (fzf keeps
# Ctrl-T files / Alt-C dirs). --disable-up-arrow leaves ↑ to autosuggestions.
command -v atuin >/dev/null 2>&1 && eval "$(atuin init zsh --disable-up-arrow)"

# direnv: auto-load per-project .envrc (run `direnv allow` once per project)
command -v direnv >/dev/null 2>&1 && eval "$(direnv hook zsh)"

# fzf-tab: replace zsh's completion menu with fzf (loads after compinit).
# Previews dir contents with eza on `cd`. Not in apt — cloned via .chezmoiexternal.
source "$HOME/.config/zsh/plugins/fzf-tab/fzf-tab.zsh" 2>/dev/null
zstyle ':fzf-tab:*' use-fzf-default-opts yes
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --icons --color=always $realpath'
zstyle ':completion:*:descriptions' format '[%d]'
